<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:factuurWizard="clr-namespace:FactuurWizard"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FactuurWizard.InvoiceItem">
    <Border BorderBrush="{DynamicResource OutlineBackground}" BorderThickness="1"
            CornerRadius="8" Padding="16 14" VerticalAlignment="Stretch">
        <StackPanel Spacing="12">
            <factuurWizard:InvoiceField Label="Referentie" Independant="True" ValueChanged="OnRefernceNumberChanged" />
            <factuurWizard:InvoiceField Label="Omschrijving" Independant="True" ValueChanged="OnDescriptionChanged" />
            <factuurWizard:InvoiceField Label="Prijs" Independant="True" ValueChanged="OnPriceChanged" />
        </StackPanel>
    </Border>
</UserControl>