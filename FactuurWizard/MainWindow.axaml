<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:factuurWizard="clr-namespace:FactuurWizard"
        mc:Ignorable="d" d:DesignWidth="665" d:DesignHeight="800"
        Background="{DynamicResource WindowBackground}"
        x:Class="FactuurWizard.MainWindow"
        Icon="/Assets/logo.ico"
        Title="Nieuw Factuur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Width="665" Height="755"
        MinWidth="665" MinHeight="755"
        RequestedThemeVariant="Light"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AtlassianSans}">

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          Margin="15 42 15 15" ColumnSpacing="20" RowSpacing="20">
        <StackPanel Grid.Row="0" Grid.Column="0">
            <StackPanel Name="TopLeftSections" Spacing="20">
                <Border BorderBrush="{DynamicResource OutlineBackground}" BorderThickness="1"
                        CornerRadius="8" Padding="16 14">
                    <StackPanel Spacing="12">
                        <factuurWizard:InvoiceField Label="Naam" />
                        <factuurWizard:InvoiceField Label="Adres 1" />
                        <factuurWizard:InvoiceField Label="Adres 2" />
                        <factuurWizard:InvoiceField Label="Land" />
                        <factuurWizard:InvoiceField Label="BTW Nummer" />
                        <factuurWizard:InvoiceField Label="ID Nummer" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource OutlineBackground}" BorderThickness="1"
                        CornerRadius="8" Padding="16 14">
                    <StackPanel Spacing="12">
                        <factuurWizard:InvoiceField Label="Factuurnummer" />
                        <factuurWizard:InvoiceField Label="Factuurdatum" />
                        <factuurWizard:InvoiceField Label="Vervaldatum" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource OutlineBackground}"
                BorderThickness="1" CornerRadius="8" Padding="16 14">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="54">
                    <factuurWizard:InvoiceField Grid.Column="0" Label="Merk" />
                    <factuurWizard:InvoiceField Grid.Column="1" Label="Cylinderinhoud" />
                </Grid>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="54">
                    <factuurWizard:InvoiceField Grid.Column="0" Label="Model" />
                    <factuurWizard:InvoiceField Grid.Column="1" Label="Vermogen (kW)" />
                </Grid>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="54">
                    <factuurWizard:InvoiceField Grid.Column="0" Label="Chassisnummer" />
                    <factuurWizard:InvoiceField Grid.Column="1" Label="Kilometerstand" />
                </Grid>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="54">
                    <factuurWizard:InvoiceField Grid.Column="0" Label="Modeljaar" />
                    <factuurWizard:InvoiceField Grid.Column="1" Label="1ste inschrijving" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource OutlineBackground}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top"
                Height="{Binding Bounds.Height, ElementName=TopLeftSections}" Padding="0 14 0 0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <Border Grid.Row="0" Padding="16 0">
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto" ColumnSpacing="16"
                          HorizontalAlignment="Stretch">
                        <Button Name="AddItemButton" Classes="Button" Grid.Column="0"
                                HorizontalAlignment="Stretch" Click="OnNewItemClick">
                            <TextBlock Text="Toevoegen" />
                        </Button>
                        <Button Name="RemoveItemButton" Classes="Button" Grid.Column="1"
                                HorizontalAlignment="Stretch" Click="OnRemoveItemClick">
                            <TextBlock Text="Verwijderen" />
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" Padding="16 0 16 16" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="ItemContainer" Spacing="12" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox Classes="TextBox" Name="OutputDirectoryTextBox" Grid.Column="0"
                         IsReadOnly="True" />
                <Button Classes="Button" Grid.Column="1" Click="OnBrowseOutputDirectoryClicked">
                    <PathIcon Width="20" Height="20" Foreground="{DynamicResource PrimaryText}"
                              Data="M51.336,31H23.641c-0.868,0-1.637,0.56-1.903,1.386L17.348,46c0.338,0,0.764,0,1.083,0h28.099	c0.436,0,0.821-0.283,0.953-0.698l4.317-13.67c0.049-0.156,0.016-0.314-0.071-0.433C51.64,31.08,51.5,31,51.336,31z M48,20H29.104	c-1.81,0-3.585-0.623-4.998-1.753l-1.712-1.37C21.688,16.311,20.801,16,19.896,16H16c-1.103,0-2,0.897-2,2v23.869	c0,0.443,0,1.047,0,1.48l3.931-12.19C18.731,28.671,21.026,27,23.641,27H50v-5C50,20.897,49.103,20,48,20z M48,16	c3.309,0,6,2.691,6,6v5.546c0.473,0.274,0.895,0.639,1.225,1.089c0.751,1.024,0.971,2.358,0.588,3.569l-4.516,14.301	C50.636,48.596,48.72,50,46.529,50H16c-3.309,0-6-2.691-6-6V18c0-3.309,2.691-6,6-6h3.896c1.81,0,3.585,0.623,4.998,1.753	l1.713,1.37C27.312,15.689,28.199,16,29.104,16H48z" />
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Button Classes="Button" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnNewInvoiceClick">
                    <TextBlock Text="Nieuw Factuur" />
                </Button>
                <Button Classes="Button" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnOpenInvoiceClicked">
                    <TextBlock Text="Open Factuur" />
                </Button>
                <Button Classes="Button" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnSaveInvoiceClicked">
                    <TextBlock Text="Factuur Opslaan" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>